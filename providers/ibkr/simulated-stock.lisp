(in-package #:cl-trading-platforms.ibkr)

(defstruct stock-bar timestamp open high low close volume)

(defun stock-replay-error (control &rest arguments)
  (error 'ibkr-error :message (apply #'format nil control arguments)))

(defun decimal-price (text)
  (let ((dot (position #\. text)))
    (if dot
        (let ((fraction (subseq text (1+ dot))))
          (unless (and (plusp dot) (plusp (length fraction))
                       (every #'digit-char-p (subseq text 0 dot))
                       (every #'digit-char-p fraction))
            (error "Invalid price ~S" text))
          (+ (parse-integer text :end dot)
             (/ (parse-integer fraction) (expt 10 (length fraction)))))
        (parse-integer text))))

(defun csv-stock-bar (fields)
  (destructuring-bind (timestamp open high low close volume) fields
    (let ((timestamp (parse-integer timestamp)) (volume (parse-integer volume))
          (open (decimal-price open)) (high (decimal-price high))
          (low (decimal-price low)) (close (decimal-price close)))
      (unless (and (plusp timestamp) (< timestamp 100000000000) (not (minusp volume))
                   (plusp low) (<= low open high) (<= low close high))
        (error "Invalid OHLCV values"))
      (make-stock-bar :timestamp timestamp :open open :high high :low low
                      :close close :volume volume))))

(defun stock-csv-fields (line)
  (mapcar (lambda (field) (string-trim '(#\Space #\Tab #\Return) field))
          (uiop:split-string line :separator ",")))

(defun read-stock-bars (path)
  (with-open-file (stream path)
    (unless (equalp (stock-csv-fields (or (read-line stream nil) ""))
                    '("timestamp" "open" "high" "low" "close" "volume"))
      (stock-replay-error "Expected timestamp,open,high,low,close,volume header in ~A." path))
    (let ((bars (make-array 0 :adjustable t :fill-pointer 0)) (previous 0))
      (loop for line = (read-line stream nil) while line for n from 2
            unless (zerop (length (string-trim '(#\Space #\Tab #\Return) line)))
              do (let ((bar (handler-case (csv-stock-bar (stock-csv-fields line))
                              (error (e) (stock-replay-error "~A line ~D: ~A" path n e)))))
                   (unless (> (stock-bar-timestamp bar) previous)
                     (stock-replay-error "~A line ~D: timestamps must strictly increase." path n))
                   (setf previous (stock-bar-timestamp bar))
                   (vector-push-extend bar bars)))
      (when (zerop (length bars)) (stock-replay-error "Stock replay file ~A has no bars." path))
      bars)))

(defstruct replay-order
  id reference side quantity type limit tif day (filled 0) (value 0) (status "Submitted"))

(defclass simulated-stock-platform (platform)
  ((account :reader account-id :initarg :account-id)
   (ticker :reader replay-symbol :initarg :symbol)
   (conid :reader replay-conid :initarg :conid)
   (listing-exchange :reader replay-exchange :initarg :listing-exchange)
   (bars :reader replay-bars :initarg :bars)
   (index :accessor replay-index :initform -1)
   (lock :reader replay-lock :initform (bt:make-recursive-lock "stock replay"))
   (cash :accessor replay-cash :initarg :cash)
   (shares :accessor replay-shares :initform 0)
   (orders :reader replay-orders :initform (make-hash-table :test #'equal))
   (references :reader replay-references :initform (make-hash-table :test #'equal))
   (active :accessor replay-active :initform nil)
   (fills :accessor replay-fills :initform nil)
   (fill-counter :accessor replay-fill-counter :initform 0)))

(defun make-simulated-stock-platform (&key bars-path symbol conid (cash 100000)
                                           listing-exchange (account-id "SIM-STOCK"))
  "Replay a single USD stock. The account starts with CASH and zero shares."
  (unless (and bars-path symbol (plusp (length (string symbol))) (typep conid '(integer 1))
               (typep cash '(real 0)) (stringp account-id) (plusp (length account-id)))
    (stock-replay-error "Provide a bars file, stock symbol, positive conid, account ID and nonnegative cash."))
  (make-instance 'simulated-stock-platform :account-id account-id :listing-exchange listing-exchange
                 :symbol (string-upcase (string symbol)) :conid conid :cash (rationalize cash)
                 :bars (read-stock-bars bars-path)))

(defmacro with-replay-lock ((client) &body body)
  `(bt:with-recursive-lock-held ((replay-lock ,client)) ,@body))

(defun simulation-cash (client)
  (with-replay-lock (client) (replay-cash client)))

(defun current-stock-bar (client)
  (with-replay-lock (client)
    (let ((index (replay-index client)) (bars (replay-bars client)))
      (unless (< -1 index (length bars))
        (stock-replay-error "There is no current stock bar. Advance the replay before polling or submitting."))
      (aref bars index))))

(defmethod platform-time ((client simulated-stock-platform))
  (stock-bar-timestamp (current-stock-bar client)))

(defmethod contract-details ((client simulated-stock-platform) conid)
  (unless (eql conid (replay-conid client)) (stock-replay-error "Unknown replay contract ~A." conid))
  `(("symbol" . ,(replay-symbol client)) ("conid" . ,conid)
    ("listingExchange" . ,(replay-exchange client)) ("currency" . "USD") ("secType" . "STK")))

(defmethod contract-search ((client simulated-stock-platform) symbol name security-type)
  (declare (ignore name))
  (if (and (string-equal symbol (replay-symbol client)) (string-equal security-type "STK"))
      (vector (contract-details client (replay-conid client)))
      #()))

(defmethod stock-contracts ((client simulated-stock-platform) symbol)
  (when (string-equal symbol (replay-symbol client))
    (list (cons (replay-symbol client)
                (vector `(("assetClass" . "STK")
                          ("contracts" . ,(vector `(("conid" . ,(replay-conid client))
                                                    ("exchange" . ,(replay-exchange client)))))))))))

(defmethod platform-status ((client simulated-stock-platform)) '(("simulated" . t)))

(defmethod accounts ((client simulated-stock-platform) &key portfolio &allow-other-keys)
  (if portfolio (vector (list (cons "accountId" (account-id client))))
      `(("selectedAccount" . ,(account-id client)) ("accounts" . ,(vector (account-id client))))))

(defmethod market-snapshot ((client simulated-stock-platform) conid &key fields &allow-other-keys)
  (declare (ignore fields))
  (unless (eql conid (replay-conid client)) (stock-replay-error "Unknown replay contract ~A." conid))
  (let ((bar (current-stock-bar client)))
    (vector `(("conid" . ,conid) ("31" . ,(coerce (stock-bar-close bar) 'double-float))
              ("87" . ,(stock-bar-volume bar)) ("6509" . "RP")
              ("t" . ,(stock-bar-timestamp bar)) ("_updated" . ,(* 1000 (stock-bar-timestamp bar)))))))

(defun replay-order-remaining (order)
  (- (replay-order-quantity order) (replay-order-filled order)))

(defun replay-order-report (client order)
  `(("acctId" . ,(account-id client)) ("conid" . ,(replay-conid client))
    ("orderId" . ,(replay-order-id order)) ("order_ref" . ,(replay-order-reference order))
    ("status" . ,(replay-order-status order)) ("side" . ,(replay-order-side order))
    ("filledQuantity" . ,(replay-order-filled order)) ("remainingQuantity" . ,(replay-order-remaining order))
    ("avgPrice" . ,(if (plusp (replay-order-filled order))
                       (coerce (/ (replay-order-value order) (replay-order-filled order)) 'double-float)
                       0))))

(defun replay-find-order (client id)
  (or (gethash (princ-to-string id) (replay-orders client))
      (stock-replay-error "Unknown simulated stock order ~A." id)))

(defmethod order-status ((client simulated-stock-platform) id)
  (with-replay-lock (client)
    (replay-order-report client (replay-find-order client id))))

(defmethod live-orders ((client simulated-stock-platform) &key filters force &allow-other-keys)
  (declare (ignore force))
  (when filters (stock-replay-error "Filtered order snapshots are unsupported in stock replay."))
  (with-replay-lock (client)
    `(("snapshot" . t) ("orders" . ,(map 'vector (lambda (order) (replay-order-report client order))
                                         (replay-active client))))))

(defmethod trades ((client simulated-stock-platform))
  (with-replay-lock (client)
    (coerce (replay-fills client) 'vector)))

(defmethod positions ((client simulated-stock-platform) &key (page 0) &allow-other-keys)
  (with-replay-lock (client)
    (if (and (zerop page) (plusp (replay-shares client)))
        (vector `(("acctId" . ,(account-id client)) ("conid" . ,(replay-conid client))
                  ("position" . ,(replay-shares client))))
        #())))

(defun stock-request-field (request key)
  (cdr (assoc key request :test #'string=)))

(defun check-stock-account (client account)
  (when (and account (not (equal (account-id client) account)))
    (stock-replay-error "Account ~A differs from the stock replay account." account)))

(defun validate-replay-request (client request account)
  (check-stock-account client account)
  (check-stock-account client (stock-request-field request "acctId"))
  (let* ((type (stock-request-field request "orderType")) (side (stock-request-field request "side"))
         (quantity (stock-request-field request "quantity")) (price (stock-request-field request "price"))
         (tif (or (stock-request-field request "tif") "DAY"))
         (conid (stock-request-field request "conid")) (reference (stock-request-field request "cOID"))
         (bar (current-stock-bar client)))
    (unless (and (eql conid (replay-conid client)) (member side '("BUY" "SELL") :test #'equal)
                 (equal "STK" (or (stock-request-field request "secType") "STK"))
                 (not (member (stock-request-field request "outsideRTH") (list t yason:true)))
                 (member type '("LMT" "MKT") :test #'equal) (member tif '("DAY" "GTC") :test #'equal)
                 (realp quantity) (plusp quantity) (= quantity (truncate quantity))
                 (if (equal type "MKT") (null price) (typep price '(real (0)))))
      (stock-replay-error "Stock replay accepts positive whole-share MKT or LMT orders with DAY or GTC."))
    (when (and reference (gethash reference (replay-references client)))
      (stock-replay-error "Duplicate simulated client order ID ~A." reference))
    (let* ((buy (equal side "BUY"))
           (estimated (or price (stock-bar-close bar)))
           (reserved (loop for order in (replay-active client)
                           when (equal side (replay-order-side order))
                             sum (* (replay-order-remaining order)
                                    (if buy (or (replay-order-limit order) (stock-bar-close bar)) 1)))))
      (when (> (+ reserved (* quantity (if buy estimated 1)))
               (if buy (replay-cash client) (replay-shares client)))
        (stock-replay-error "Insufficient available ~A for this simulated order." (if buy "cash" "shares"))))
    (make-replay-order :reference reference :side side :type type :limit (and price (rationalize price))
                       :quantity (truncate quantity) :tif tif :day (floor (stock-bar-timestamp bar) 86400))))

(defmethod preview-platform-order ((client simulated-stock-platform) request &key account-id &allow-other-keys)
  (with-replay-lock (client)
    (validate-replay-request client request account-id)
    '(("whatif" . "ok"))))

(defmethod submit-platform-order ((client simulated-stock-platform) request &key live account-id &allow-other-keys)
  (when live (stock-replay-error "Use simulated execution with a stock replay client."))
  (with-replay-lock (client)
    (let* ((order (validate-replay-request client request account-id))
           (id (write-to-string (1+ (hash-table-count (replay-orders client))))))
      (setf (replay-order-id order) id
            (gethash id (replay-orders client)) order
            (replay-active client) (nconc (replay-active client) (list order)))
      (when (replay-order-reference order)
        (setf (gethash (replay-order-reference order) (replay-references client)) order))
      (replay-order-report client order))))

(defmethod cancel-account-order ((client simulated-stock-platform) id account)
  (check-stock-account client account)
  (with-replay-lock (client)
    (let ((order (replay-find-order client id)))
      (when (member order (replay-active client))
        (setf (replay-order-status order) "Cancelled"
              (replay-active client) (delete order (replay-active client))))
      (replay-order-report client order))))

(defun replay-match-price (order bar)
  (let ((open (stock-bar-open bar)) (limit (replay-order-limit order)))
    (cond ((equal (replay-order-type order) "MKT") open)
          ((equal (replay-order-side order) "BUY")
           (when (<= (stock-bar-low bar) limit) (min open limit)))
          ((>= (stock-bar-high bar) limit) (max open limit)))))

(defun fill-replay-order (client order bar price size)
  (let ((signed (if (equal (replay-order-side order) "BUY") size (- size))))
    (incf (replay-shares client) signed)
    (decf (replay-cash client) (* signed price)))
  (incf (replay-order-filled order) size)
  (incf (replay-order-value order) (* price size))
  (setf (replay-order-status order)
        (if (zerop (replay-order-remaining order)) "Filled" "PartiallyFilled"))
  (push `(("acctId" . ,(account-id client)) ("conid" . ,(replay-conid client))
          ("symbol" . ,(replay-symbol client)) ("orderId" . ,(replay-order-id order))
          ("order_ref" . ,(replay-order-reference order)) ("side" . ,(replay-order-side order))
          ("execution_id" . ,(format nil "SIM-~D" (incf (replay-fill-counter client))))
          ("size" . ,size) ("price" . ,(coerce price 'double-float))
          ("trade_time_r" . ,(* 1000 (stock-bar-timestamp bar))))
        (replay-fills client)))

(defun match-stock-bar (client bar)
  (let ((volume (stock-bar-volume bar)) (day (floor (stock-bar-timestamp bar) 86400)))
    (dolist (order (replay-active client))
      (cond ((and (equal (replay-order-tif order) "DAY") (/= day (replay-order-day order)))
             (setf (replay-order-status order) "Expired"))
            ((plusp volume)
             (let ((price (replay-match-price order bar)))
               (when price
                 (let* ((wanted (min volume (replay-order-remaining order)))
                        (available (if (equal (replay-order-side order) "BUY")
                                       (floor (replay-cash client) price)
                                       (replay-shares client)))
                        (size (min wanted available)))
                   (when (plusp size)
                     (fill-replay-order client order bar price size)
                     (decf volume size))
                   ;; A gap can exceed the available cash after a market order was accepted.
                   (when (< size wanted) (setf (replay-order-status order) "Cancelled")))))))))
  (setf (replay-active client)
        (remove-if-not (lambda (order) (member (replay-order-status order)
                                              '("Submitted" "PartiallyFilled") :test #'equal))
                       (replay-active client))))

(defun advance-stock-replay (client)
  "Match working orders on the next bar, then expose its closing quote. Return NIL at EOF.
At EOF the replay ends and outstanding orders are canceled."
  (with-replay-lock (client)
    (let ((next (1+ (replay-index client))) (bars (replay-bars client)))
      (cond ((< next (length bars))
             (setf (replay-index client) next)
             (match-stock-bar client (aref bars next))
             t)
            (t
             (setf (replay-index client) (length bars))
             (dolist (order (replay-active client)) (setf (replay-order-status order) "Cancelled"))
             (setf (replay-active client) nil)
             nil)))))
